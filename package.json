{
  "name": "platform-domain-router",
  "version": "0.1.0",
  "description": "Multi-SaaS custom domain catch-all router for Traefik/Coolify",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt --check src tests",
    "format:fix": "oxfmt src tests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.16.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
