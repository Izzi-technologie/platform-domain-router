# Copy to .env for local / docker-compose.yml
# Coolify: paste the same keys in the resource Environment Variables.

# Production (shared VPS): IZZIPAY + School360. Paste as a single line in Coolify env.
SAAS_SERVICES=[{"id":"izzipay","resolveUrl":"http://platform-api:4215/api/v1/public/sites/resolve-host","upstreamUrl":"http://edge-router:4270","priority":10,"enabled":true},{"id":"school360","resolveUrl":"http://school360-api:3001/api/v1/public/resolve-host","upstreamUrl":"http://school360-dashboard:3000","priority":10,"enabled":true}]

CACHE_TTL_MS=60000
NEGATIVE_CACHE_TTL_MS=30000
RESOLVE_TIMEOUT_MS=2000
PROXY_TIMEOUT_MS=30000

# Optional extra upstream hostnames (comma-separated). Service upstream hosts are allowlisted automatically.
# UPSTREAM_HOST_ALLOWLIST=edge-router,school360-dashboard
